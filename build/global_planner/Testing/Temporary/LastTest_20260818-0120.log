+    qt[1] = +cos(qi[2] - t) - ct;
+    qt[2] = -t;
+  } else if(type == S_SEG) {
+    qt[0] = ct * t;
+    qt[1] = st * t;
+    qt[2] = 0.0;
+  }
+  qt[0] += qi[0];
+  qt[1] += qi[1];
+  qt[2] += qi[2];
